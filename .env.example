# Copy to .env.local. Vite exposes VITE_* to the browser.
VITE_TAVILY_API_KEY=tvly-...
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Optional. Without these the app uses a localStorage-backed store that
# implements the same Store interface — everything works, nothing syncs.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
